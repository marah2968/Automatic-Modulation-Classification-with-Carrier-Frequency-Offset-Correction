- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pickle\nimport\
      \ sys\nimport os\nos.environ['TF_ENABLE_ONEDNN_OPTS'] = '0'\nimport tensorflow\
      \ as tf\nfrom tensorflow import keras\nfrom keras import metrics, regularizers,\
      \ backend\nfrom keras.models import Model\nfrom tensorflow.keras.models import\
      \ Sequential, load_model\nfrom keras.layers import Input, Dense\nfrom keras.callbacks\
      \ import EarlyStopping, ModelCheckpoint\nfrom keras import optimizers\nfrom\
      \ keras.layers import Dense, Dropout, Activation\nfrom keras.layers import Embedding\n\
      from keras.utils import to_categorical\nfrom keras.layers import Conv1D,MaxPooling1D,\
      \ Flatten,AveragePooling1D,Reshape,concatenate\nfrom keras.layers import Conv2D,\
      \ GlobalMaxPooling1D ,MaxPooling2D\nfrom keras.constraints import unit_norm\n\
      from tensorflow.keras.layers import Concatenate\nfrom keras.models import load_model\n\
      from tensorflow.keras.layers import Input,GRU, Conv2D, Dense,Add,Subtract, Dropout,Multiply,\
      \ BatchNormalization, Activation,Lambda, Flatten, Reshape, MaxPooling2D, concatenate\n\
      \nsys.stdout.reconfigure(encoding='utf-8')\n\n\n# Your code here\n\nclass blk(gr.sync_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n    \"\"\
      \"Embedded Python Block example - a simple multiply const\"\"\"\n\n\n    def\
      \ __init__(self, example_param=1):  # only default arguments here\n        \"\
      \"\"arguments to this function show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n\
      \            self,\n            name='MMM',   # will show up in GRC\n      \
      \      in_sig=[np.complex64],  # Two input signals\n            out_sig=[np.float32]\n\
      \        )\n\n    def work(self, input_items, output_items):\n        # Extract\
      \ the first 128 elements from each input\n        psd1 = np.array(input_items)\n\
      \        #np.savetxt('C:/Users/asus/Downloads/m1_BPSK.txt', psd1.reshape(-1),\
      \ delimiter=',')\n        print(len(np.transpose(psd1)))\n\n        input_chunks\
      \ = psd1.reshape(-1, 128)  # Now input_chunks has shape (16, 128)\n\n      \
      \  m1_list = []\n        m2_list = []\n\n        for chunk in input_chunks:\n\
      \            energy = np.sum(np.abs(chunk))\n            normalized_chunk =\
      \ chunk / energy\n\n            m1 = np.real(normalized_chunk)\n           \
      \ m2 = np.imag(normalized_chunk)\n\n            m1_list.append(m1)\n       \
      \     m2_list.append(m2)\n\n# Convert lists to numpy arrays\n        m1_array\
      \ = np.array(m1_list)  # Shape will be (16, 128)\n        m2_array = np.array(m2_list)\
      \  # Shape will be (16, 128)\n\n        print(\"Shape of m1_array:\", m1_array.shape)\n\
      \        print(\"Shape of m2_array:\", m2_array.shape)\n\n        # Debugging\
      \ prints (if needed)\n        try:\n            print(m1)\n        except UnicodeEncodeError\
      \ as e:\n            print(f\"Encoding error in print: {e}\")\n        try:\n\
      \            print(m2)\n        except UnicodeEncodeError as e:\n          \
      \  print(f\"Encoding error in print: {e}\")\n\n        m = np.stack((m1_array,\
      \ m2_array), axis=-1)\n\n# Expand dimensions of m to add a new axis at the end\n\
      \        m_expanded = np.expand_dims(m, axis=3)\n\n# m_expanded will now have\
      \ shape (16, 128, 2, 1)\n        print(\"Shape of m_expanded:\", m_expanded.shape)\n\
      \n        # Predict with the model\n        file_path = 'C:/Users/asus/Downloads/mydata12.pkl'\n\
      \n# Save the arrays in a .pkl file\n        with open(file_path, 'wb') as file:\n\
      \            pickle.dump((m_expanded, m1_array, m2_array), file)\n\n       \
      \ return output_items[0]\n"
    affinity: ''
    alias: ''
    comment: ''
    example_param: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('MMM', 'blk', [('example_param', '1')], [('0', 'complex', 1)], [('0',
      'float', 1)], 'Embedded Python Block example - a simple multiply const', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 480.0]
    rotation: 180
    state: true
