- name: epy_module_1
  id: epy_module
  parameters:
    alias: ''
    comment: ''
    source_code: "import pickle\r\nimport numpy as np\r\nimport tensorflow as tf\r\
      \nfrom tensorflow import keras\r\nfrom keras.models import Model,load_model\r\
      \nfrom keras import optimizers\r\n\r\n\r\nfrom keras import metrics, regularizers,\
      \ backend\r\nfrom keras.layers import Input, Dense\r\nfrom keras.layers import\
      \ Dense, Dropout, Activation\r\nfrom keras.layers import Embedding\r\nfrom keras.layers\
      \ import Conv1D,MaxPooling1D, Flatten,AveragePooling1D,Reshape,concatenate\r\
      \nfrom keras.layers import Conv2D, GlobalMaxPooling1D ,MaxPooling2D\r\nfrom\
      \ tensorflow.keras.layers import Concatenate\r\nfrom keras.models import load_model\r\
      \nfrom tensorflow.keras.layers import Input,GRU, Conv2D, Dense,Add,Subtract,\
      \ Dropout,Multiply, BatchNormalization, Activation,Lambda, Flatten, Reshape,\
      \ MaxPooling2D, concatenate\r\nfrom keras.optimizers import Adam\r\nimport os\r\
      \n\r\n\r\nfrom tensorflow.keras.layers import Input,Activation, Conv1D,concatenate,\
      \ MaxPooling1D, Dropout, GRU, Flatten, Dense, Concatenate, Lambda,Multiply,\
      \ Add, Subtract, Reshape\r\nfrom tensorflow.keras.models import Model\r\nimport\
      \ tensorflow as tf\r\nimport sys\r\nsys.stdout.reconfigure(encoding='utf-8')\r\
      \n\r\ndef CNN(input_shape=(128, 2), input_shape2=(128, 1), classes=11):\r\n\r\
      \n    # Define input layers\r\n    dr = 0.5 # dropout rate (%)\r\n    input\
      \ = Input(shape=input_shape + (1,), name='input1')  # Shape will be (None, 2,\
      \ 128, 1)\r\n    input1 = Input(input_shape2, name='input2')\r\n    input2 =\
      \ Input(input_shape2, name='input3')\r\n\r\n\r\n\r\n    # spatial feature\r\n\
      \    x3 = Conv2D(75, (8,2), padding='valid', activation=\"relu\", name=\"conv1_1\"\
      , kernel_initializer='glorot_uniform')(\r\n        input)\r\n    x3 = Conv2D(25,\
      \ (5,1), padding='valid', activation=\"relu\", name=\"conv1_2\", kernel_initializer='glorot_uniform')(\r\
      \n        x3)\r\n    # temporal feature\r\n    x4 = Reshape(target_shape=((117,25)),\
      \ name='reshape4')(x3)\r\n    x4= GRU(units=128)(x4)\r\n\r\n    x = Dense(classes,\
      \ activation='softmax', name='softmax')(x4)\r\n\r\n\r\n    model = Model(inputs\
      \ = [input,input1,input2], outputs=x)\r\n\r\n\r\n\r\n    return model\r\n\r\n\
      \r\n\r\n\r\n\r\n\r\n\r\nmodel=CNN()\r\n\r\n\r\nmodel.load_weights('C:/Users/asus/Downloads/CNN_2D_weights.h5')\r\
      \n\r\n\r\nfile_path = 'C:/Users/asus/Downloads/mydata15.pkl'\r\nif os.path.getsize(file_path)\
      \ > 0:\r\n    with open(file_path, 'rb') as f:\r\n        loaded_array1, loaded_array2,\
      \ loaded_array3 = pickle.load(f)\r\n    print(\"Arrays loaded successfully.\"\
      )\r\nelse:\r\n    print(\"The file is empty.\")\r\ntest_Y_hat =100*model.predict([loaded_array1,loaded_array2,loaded_array3],batch_size=1)\r\
      \nmean_array = np.mean(test_Y_hat, axis=0).reshape(1, 11)\r\n\r\nrows_3_to_16\
      \ = test_Y_hat[2:, :]\r\n\r\n# Calculate the mean along the first axis (rows)\r\
      \nmean_array = np.mean(rows_3_to_16, axis=0).reshape(1, 11)\r\nprint(\"Mean\
      \ array :\")\r\nprint(mean_array)\r\nmodtype=['8PSK','AM-DSB','AM-SSB','BPSK','CPFSK','GFSK','4-PAM','16-QAM','64-QAM','QPSK','WBFM']\r\
      \ny=np.argmax(mean_array)\r\nm=modtype[int(y)]\r\nprint(\"modulation:\",m)\r\
      \n\r\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 144.0]
    rotation: 0
    state: true
connections: []

